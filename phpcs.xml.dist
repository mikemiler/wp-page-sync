<?xml version="1.0"?>
<ruleset name="WP Page Sync">
	<description>WordPress coding + security standards for the WP Page Sync plugin.</description>

	<!-- Scan the plugin's own code. -->
	<file>.</file>

	<!-- Third-party / generated / non-PHP assets stay out of the scan. -->
	<exclude-pattern>*/lib/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<!-- Only sniff PHP. -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<!-- CI gate fails on errors; warnings are reported but non-blocking. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<!-- Core + best-practice + security sniffs (no Docs block standard). -->
	<rule ref="WordPress-Extra"/>

	<!-- PHP 7.4+ compatibility, targeting the plugin's minimum WP version. -->
	<config name="minimum_wp_version" value="6.5"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Project prefixes so global-namespace sniffs pass. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wpps"/>
				<element value="WPPS_"/>
			</property>
		</properties>
	</rule>

	<!-- The admin partials are require'd from inside WPPS_Admin::render_page(),
	     so their variables are method-local, not global. PHPCS analyses every
	     file standalone and cannot see that, so it reports the template's loop
	     variables as unprefixed globals. Scoped to the partials only; the sniff
	     stays fully active everywhere else. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>*/admin/partials/*</exclude-pattern>
	</rule>

	<!-- Text domain for i18n sniffs. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-page-sync"/>
			</property>
		</properties>
	</rule>
</ruleset>
